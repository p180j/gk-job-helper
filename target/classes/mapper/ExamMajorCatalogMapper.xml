<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gk.jobhelper.mapper.ExamMajorCatalogMapper">

    <sql id="Base_Column_List">
        id, exam_id, catalog_id, priority, created_at
    </sql>

    <resultMap id="BaseResultMap" type="com.gk.jobhelper.entity.ExamMajorCatalog">
        <id property="id" column="id"/>
        <result property="examId" column="exam_id"/>
        <result property="catalogId" column="catalog_id"/>
        <result property="priority" column="priority"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectByExamId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM exam_major_catalog
        WHERE exam_id = #{examId}
        ORDER BY priority ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO exam_major_catalog (exam_id, catalog_id, priority, created_at)
        VALUES (#{examId}, #{catalogId}, #{priority}, #{createdAt})
    </insert>

    <delete id="deleteAll">
        DELETE FROM exam_major_catalog
    </delete>
</mapper>
