<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gk.jobhelper.mapper.MajorCatalogMapper">

    <sql id="Base_Column_List">
        id, catalog_code, catalog_name, catalog_type, education_level, version,
        source_name, source_url, source_year, priority, enabled, created_at, updated_at
    </sql>

    <resultMap id="BaseResultMap" type="com.gk.jobhelper.entity.MajorCatalog">
        <id property="id" column="id"/>
        <result property="catalogCode" column="catalog_code"/>
        <result property="catalogName" column="catalog_name"/>
        <result property="catalogType" column="catalog_type"/>
        <result property="educationLevel" column="education_level"/>
        <result property="version" column="version"/>
        <result property="sourceName" column="source_name"/>
        <result property="sourceUrl" column="source_url"/>
        <result property="sourceYear" column="source_year"/>
        <result property="priority" column="priority"/>
        <result property="enabled" column="enabled"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM major_catalog
        ORDER BY priority ASC, id ASC
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM major_catalog
        WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM major_catalog
        WHERE catalog_code = #{catalogCode}
    </select>

    <select id="selectEnabledByTypeAndLevel" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM major_catalog
        WHERE enabled = 1
          AND catalog_type = #{catalogType}
          <if test="educationLevel != null and educationLevel != ''">
              AND (education_level = #{educationLevel} OR education_level = 'MIXED')
          </if>
        ORDER BY priority ASC, id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO major_catalog (catalog_code, catalog_name, catalog_type, education_level, version,
                                   source_name, source_url, source_year, priority, enabled,
                                   created_at, updated_at)
        VALUES (#{catalogCode}, #{catalogName}, #{catalogType}, #{educationLevel}, #{version},
                #{sourceName}, #{sourceUrl}, #{sourceYear}, #{priority}, #{enabled},
                #{createdAt}, #{updatedAt})
    </insert>

    <delete id="deleteAll">
        DELETE FROM major_catalog
    </delete>
</mapper>
