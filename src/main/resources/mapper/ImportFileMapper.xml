<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gk.jobhelper.mapper.ImportFileMapper">

    <sql id="Base_Column_List">
        id, original_name, stored_name, stored_path, file_size, file_type, sheet_name,
        headers, total_rows, exam_year, status, created_at
    </sql>

    <resultMap id="BaseResultMap" type="com.gk.jobhelper.entity.ImportFile">
        <id property="id" column="id"/>
        <result property="originalName" column="original_name"/>
        <result property="storedName" column="stored_name"/>
        <result property="storedPath" column="stored_path"/>
        <result property="fileSize" column="file_size"/>
        <result property="fileType" column="file_type"/>
        <result property="sheetName" column="sheet_name"/>
        <result property="headers" column="headers"/>
        <result property="totalRows" column="total_rows"/>
        <result property="examYear" column="exam_year"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM import_file
        WHERE id = #{id}
    </select>

    <select id="selectLatest" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM import_file
        ORDER BY created_at DESC, id DESC
        LIMIT 1
    </select>

    <select id="selectPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM import_file
        ORDER BY created_at DESC, id DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM import_file
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO import_file (original_name, stored_name, stored_path, file_size, file_type,
                                 sheet_name, headers, total_rows, exam_year, status, created_at)
        VALUES (#{originalName}, #{storedName}, #{storedPath}, #{fileSize}, #{fileType},
                #{sheetName}, #{headers}, #{totalRows}, #{examYear}, #{status}, #{createdAt})
    </insert>

    <update id="updateStatus">
        UPDATE import_file
        SET status = #{status}
        WHERE id = #{id}
    </update>


    <delete id="deleteById">
        DELETE FROM import_file WHERE id = #{id}
    </delete>

    <delete id="deleteAll">
        DELETE FROM import_file
    </delete>
</mapper>
